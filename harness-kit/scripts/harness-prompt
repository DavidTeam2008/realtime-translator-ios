#!/usr/bin/env python3
"""harness-prompt: use harness-kit's prompt templates without opening the docs.

Usage:
    python3 harness-kit/scripts/harness-prompt list [--stage STAGE] [--json]
    python3 harness-kit/scripts/harness-prompt show <id> [--target DIR] [--set KEY=VALUE ...]
    python3 harness-kit/scripts/harness-prompt copy <id> [--target DIR] [--set ...]
    python3 harness-kit/scripts/harness-prompt render [--check] [--output PATH]

Convenience:
    `show` / `copy` compose the preamble for the selected scenario (0B for adoption
    prompts, 0A for everyday prompts), substitute the kit root and the target repository
    absolute path, and leave only genuinely user-specific placeholders (e.g. <SYMPTOM>)
    for the user to fill. When the target repository looks mismatched with the scenario
    stage (or is the kit clone itself), they print a WARN on stderr.
    `copy` writes the composed prompt to the clipboard (pbcopy / clip / wl-copy /
    xclip / xsel); when no clipboard tool is available it prints the prompt instead.

Source of truth:
    prompts/_preamble-*.md + prompts/<id>.md are the single source; the public page
    docs/agent-prompts.md is generated by `render` and checked by tests (`--check`).

Standard library only; no network. Exit codes: 0 ok; 1 usage/validation/drift.
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_KIT_ROOT = Path(__file__).resolve().parent.parent
PROMPTS_DIRNAME = "prompts"
DOC_REL = Path("docs") / "agent-prompts.md"
PKG_MARKER = "## 0. 公共前置"
PREAMBLE_FILES = {
    "adopted": "_preamble-adopted.md",
    "adoption": "_preamble-adoption.md",
}
STAGE_LABELS = {"unadopted": "未接入", "adopted": "已接入", "any": "附加"}
GROUP_ORDER = ("接入与接手", "需求、计划与开发", "评审与发布", "协作与收尾", "附加片段")
CLIPBOARD_CANDIDATES = (
    ("pbcopy",),
    ("clip",),
    ("wl-copy",),
    ("xclip", "-selection", "clipboard"),
    ("xsel", "-b"),
)
PLACEHOLDER_RE = re.compile(r"\{\{([A-Z0-9_]+)\}\}")
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
SET_RE = re.compile(r"^([A-Z0-9_]+)=(.*)$", re.S)
ANGLE_TOKEN_RE = re.compile(r"<([^<>\s][^<>\n]{0,40})>")
REQUIRED_TASK_KEYS = ("id", "title", "short", "number", "group", "stage", "kind", "when", "returns", "fail_signal")


class PromptError(Exception):
    """User-facing failure (exit 1)."""


# ── loading / validation ────────────────────────────────────────────────
def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as exc:
        raise PromptError(f"cannot read {path}: {exc}") from exc


def split_front_matter(path: Path) -> tuple[dict[str, str], str]:
    text = read_text(path)
    if not text.startswith("---\n"):
        raise PromptError(f"{path}: missing front matter (must start with '---')")
    end = text.find("\n---\n", 4)
    if end < 0:
        raise PromptError(f"{path}: unterminated front matter")
    meta: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        key, sep, value = line.partition(":")
        if not sep:
            raise PromptError(f"{path}: invalid front matter line: {line!r}")
        meta[key.strip()] = value.strip()
    return meta, text[end + 5:].lstrip("\n").strip("\n")


def split_list(raw: str) -> list[str]:
    items = [item.strip() for item in raw.split(",")]
    return [item for item in items if item]


def load_prompts(kit_root: Path) -> list[dict]:
    prompts_dir = kit_root / PROMPTS_DIRNAME
    if not prompts_dir.is_dir():
        raise PromptError(f"prompts directory not found: {prompts_dir}")
    prompts: list[dict] = []
    seen_ids: set[str] = set()
    seen_numbers: dict[int, str] = {}
    for path in sorted(prompts_dir.glob("*.md")):
        if path.name.startswith("_"):
            continue
        meta, body = split_front_matter(path)
        prompt_id = meta.get("id", "")
        if prompt_id != path.stem:
            raise PromptError(f"{path.name}: front matter id must equal the file stem ({prompt_id!r})")
        if not ID_RE.match(prompt_id):
            raise PromptError(f"{path.name}: invalid id {prompt_id!r}")
        if prompt_id in seen_ids:
            raise PromptError(f"duplicate prompt id: {prompt_id}")
        seen_ids.add(prompt_id)
        for key in REQUIRED_TASK_KEYS:
            if key == "returns" or key == "fail_signal":
                continue
            if not meta.get(key):
                raise PromptError(f"{path.name}: missing front matter key: {key}")
        kind = meta.get("kind", "")
        stage = meta.get("stage", "")
        if kind not in ("task", "addon"):
            raise PromptError(f"{path.name}: kind must be 'task' or 'addon', got {kind!r}")
        if stage not in STAGE_LABELS:
            raise PromptError(f"{path.name}: stage must be one of {sorted(STAGE_LABELS)}, got {stage!r}")
        if kind == "task" and stage not in ("unadopted", "adopted"):
            raise PromptError(f"{path.name}: task prompts must declare stage unadopted or adopted")
        if kind == "addon" and stage != "any":
            raise PromptError(f"{path.name}: addon prompts must declare stage: any")
        if kind == "task":
            for key in ("returns", "fail_signal"):
                if not meta.get(key):
                    raise PromptError(f"{path.name}: task prompt requires front matter key: {key}")
            for key in ("returns", "fail_signal", "short"):
                if "|" in meta[key]:
                    raise PromptError(f"{path.name}: front matter {key} must not contain '|' (table safety)")
        number_raw = meta.get("number", "")
        if not number_raw.isdigit():
            raise PromptError(f"{path.name}: number must be an integer")
        number = int(number_raw)
        if number < 1 or number > 99 or number == 21:
            raise PromptError(f"{path.name}: number must be 1..99 and not 21 (reserved for the scenario table)")
        if number in seen_numbers:
            raise PromptError(f"duplicate prompt number {number}: {seen_numbers[number]} and {path.name}")
        seen_numbers[number] = path.name
        placeholders = split_list(meta.get("placeholders", ""))
        found = sorted(set(PLACEHOLDER_RE.findall(body)) - {"KIT", "TARGET"})
        if sorted(found) != sorted(placeholders):
            raise PromptError(
                f"{path.name}: placeholders metadata {placeholders} does not match body {found} "
                "(KIT/TARGET are implicit and must not be listed)"
            )
        preamble = "none"
        if kind == "task":
            preamble = "adoption" if stage == "unadopted" else "adopted"
        prompts.append({
            "id": prompt_id,
            "title": meta["title"],
            "short": meta.get("short", meta["title"]),
            "number": number,
            "group": meta["group"],
            "stage": stage,
            "kind": kind,
            "when": meta["when"],
            "returns": meta.get("returns", ""),
            "fail_signal": meta.get("fail_signal", ""),
            "placeholders": placeholders,
            "preamble": preamble,
            "body": body,
            "path": path,
        })
    if not prompts:
        raise PromptError(f"no prompt files found under {prompts_dir}")
    return sorted(prompts, key=lambda item: item["number"])


def load_preambles(kit_root: Path) -> dict[str, str]:
    prompts_dir = kit_root / PROMPTS_DIRNAME
    preambles: dict[str, str] = {}
    for key, filename in PREAMBLE_FILES.items():
        path = prompts_dir / filename
        if not path.is_file():
            raise PromptError(f"missing preamble file: {path}")
        text = read_text(path).strip("\n")
        unknown = sorted(set(PLACEHOLDER_RE.findall(text)) - {"KIT", "TARGET"})
        if unknown:
            raise PromptError(f"{path}: preamble may only use {{KIT}} / {{TARGET}}, found {unknown}")
        preambles[key] = text
    return preambles


def kit_version(kit_root: Path) -> str:
    try:
        return (kit_root / "VERSION").read_text(encoding="utf-8").strip()
    except OSError:
        return "unknown"


# ── composition ─────────────────────────────────────────────────────────
def substitute(text: str, mapping: dict[str, str], declared: list[str]) -> tuple[str, list[str]]:
    missing: list[str] = []

    def replace(match: re.Match) -> str:
        key = match.group(1)
        if key in mapping:
            return mapping[key]
        if key in declared:
            missing.append(key)
            return f"<{key}>"
        raise PromptError(f"unexpected placeholder {{{{{key}}}}} (fix the prompt front matter)")

    return PLACEHOLDER_RE.sub(replace, text), missing


def compose(prompt: dict, kit_root: Path, target: Path, preambles: dict[str, str],
            values: dict[str, str], include_preamble: bool = True) -> tuple[str, list[str]]:
    mapping = {"KIT": str(kit_root.resolve()), "TARGET": str(target.resolve()), **values}
    parts: list[str] = []
    if include_preamble and prompt["preamble"] in preambles:
        preamble, _ = substitute(preambles[prompt["preamble"]], mapping, [])
        parts.append(preamble.strip("\n"))
    body, missing = substitute(prompt["body"], mapping, prompt["placeholders"])
    parts.append(body.strip("\n"))
    text = "\n\n".join(part for part in parts if part) + "\n"
    ordered = [key for key in prompt["placeholders"] if key in missing]
    if ordered != missing:
        missing = ordered
    return text, missing


# ── doc rendering (single source → docs/agent-prompts.md) ──────────────
def doc_text(text: str, declared: list[str]) -> str:
    mapping = {"KIT": "<kit>", "TARGET": "<目标仓库路径>"}
    rendered, _ = substitute(text, mapping, declared)
    if "{{" in rendered:
        raise PromptError("rendered document still contains unresolved {{...}} placeholders")
    return rendered


def fence(body: str) -> str:
    marker = "```"
    while marker in body:
        marker += "`"
    return f"{marker}text\n{body}\n{marker}"


def section_note(prompt: dict) -> str:
    copy_cmd = f"<kit>/scripts/harness-prompt copy {prompt['id']}"
    if prompt["kind"] == "addon":
        return f"> 用法：附加片段，贴到任务末尾（不单独使用）· 复制：`{copy_cmd}`"
    stage = "未接入" if prompt["stage"] == "unadopted" else "已接入"
    preamble = (
        "CLI 自动拼 0B（含 kit 路径与只读约束）；手工复制请先贴 §0B" if prompt["preamble"] == "adoption"
        else "CLI 自动拼 0A；手工复制请先贴 §0A"
    )
    replace = "、".join(f"`<{key}>`" for key in prompt["placeholders"]) or "无"
    if not prompt["placeholders"] and prompt["stage"] == "unadopted":
        replace = "无占位符（命令示例参数按第 2 步结论替换）"
    return f"> 阶段：{stage} · 前置：{preamble} · 需替换：{replace} · 复制：`{copy_cmd}`"


def render_doc(kit_root: Path) -> str:
    prompts = load_prompts(kit_root)
    preambles = load_preambles(kit_root)
    header_path = kit_root / PROMPTS_DIRNAME / "_doc-header.md"
    header = read_text(header_path).rstrip("\n")
    if PKG_MARKER not in header:
        raise PromptError(f"{header_path}: header must contain the '## 0.' preamble section heading")

    blocks: list[str] = [header, "### 0A. 已接入项目（日常任务贴这一段）"]
    blocks.append(fence(doc_text(preambles["adopted"], [])))
    blocks.append("### 0B. 未接入项目（接入阶段贴这一段；§1 / §2 的 show/copy 输出会自动带上）")
    blocks.append(fence(doc_text(preambles["adoption"], [])))

    by_number = {prompt["number"]: prompt for prompt in prompts}
    max_number = max(by_number)
    table_rows: list[str] = []
    for number in range(1, max_number + 1):
        if number == 21:
            blocks.append(
                "## 21. 场景 → Agent 应返回什么\n\n"
                "> 下表与上面的模板一一对应；完成声明至少要覆盖「Agent 必须返回」这一列。\n\n"
                + "\n".join(
                    ["| 场景 | Agent 必须返回 | 失败信号 |", "| --- | --- | --- |"]
                    + table_rows
                )
            )
            continue
        prompt = by_number.get(number)
        if prompt is None:
            continue
        blocks.append(f"## {number}. {prompt['title']}")
        blocks.append(section_note(prompt))
        blocks.append(fence(doc_text(prompt["body"], prompt["placeholders"])))
        if prompt["kind"] == "task":
            row = "| {short} | {returns} | {fail_signal} |".format(
                short=prompt["short"], returns=prompt["returns"], fail_signal=prompt["fail_signal"],
            )
            table_rows.append(row)
    return "\n\n".join(blocks).rstrip("\n") + "\n"


# ── CLI helpers ─────────────────────────────────────────────────────────
def resolve_kit(args: argparse.Namespace) -> Path:
    kit_root = Path(getattr(args, "kit", None) or DEFAULT_KIT_ROOT).expanduser().resolve()
    if not (kit_root / PROMPTS_DIRNAME).is_dir():
        raise PromptError(f"kit root has no prompts/ directory: {kit_root}")
    return kit_root


def resolve_target(args: argparse.Namespace) -> Path:
    target = Path(getattr(args, "target", None) or ".").expanduser().resolve()
    if not target.is_dir():
        raise PromptError(f"target directory does not exist: {target}")
    return target


def detect_target_stage(target: Path) -> str:
    """Best-effort: adopted = has a harness Makefile and harness/config.json."""
    has_makefile = (target / "Makefile").is_file() or (target / "Makefile.harness").is_file()
    if has_makefile and (target / "harness" / "config.json").is_file():
        return "adopted"
    return "unadopted"


def target_warnings(prompt: dict, target: Path, kit_root: Path) -> list[str]:
    warnings: list[str] = []
    resolved_kit = kit_root.resolve()
    if target == resolved_kit or resolved_kit in target.parents:
        warnings.append(
            f"[WARN] 当前目标仓库是 kit 克隆目录（{target}）；请用 --target 指向你的项目，"
            "或先 cd 到目标仓库根目录再运行。"
        )
    if prompt["kind"] != "task":
        return warnings
    actual = detect_target_stage(target)
    if actual == prompt["stage"]:
        return warnings
    actual_label = "已接入" if actual == "adopted" else "未接入"
    expected_label = "已接入" if prompt["stage"] == "adopted" else "未接入"
    hint = (
        f"若还没接入：先用 adopt-new / adopt-brownfield 场景。"
        if actual == "unadopted"
        else "若已接入：日常任务请用 fix-bug / request-feature 等场景，不要重复 init。"
    )
    warnings.append(
        f"[WARN] 目标仓库看起来{actual_label} harness-kit，但「{prompt['id']}」是{expected_label}场景模板："
        f"前置 0A/0B 与正文命令可能不适用。{hint}"
    )
    return warnings


def angle_warnings(text: str, prompt: dict) -> list[str]:
    """Warn about literal <...> tokens that are not declared placeholders."""
    allowed = {f"<{key}>" for key in prompt["placeholders"]}
    found: list[str] = []
    for match in ANGLE_TOKEN_RE.finditer(text):
        token = match.group(0)
        if token in allowed:
            continue
        if match.group(1).startswith(("http://", "https://")):
            continue
        found.append(token)
    if not found:
        return []
    unique = list(dict.fromkeys(found))
    return [
        "[提示] 正文里还有尖括号内容可能需要你替换或确认：" + "、".join(unique)
    ]


def parse_values(pairs: list[str], prompt: dict) -> dict[str, str]:
    values: dict[str, str] = {}
    for pair in pairs:
        match = SET_RE.match(pair)
        if not match:
            raise PromptError(f"--set expects KEY=VALUE with an uppercase key, got {pair!r}")
        key, value = match.group(1), match.group(2)
        if key in ("KIT", "TARGET"):
            raise PromptError("KIT / TARGET are filled automatically (use --kit / --target)")
        if key not in prompt["placeholders"]:
            raise PromptError(
                f"{prompt['id']} has no placeholder {{{{{key}}}}}; "
                f"declared: {prompt['placeholders'] or 'none'}"
            )
        values[key] = value
    return values


def format_missing(prompt_id: str, missing: list[str]) -> str:
    rendered = "、".join(f"<{key}>" for key in missing)
    return f"[提示] 还有 {len(missing)} 处需要你补充：{rendered}（可用 --set {missing[0]}=\"...\" 填好）"


def cmd_list(args: argparse.Namespace) -> int:
    kit_root = resolve_kit(args)
    target = resolve_target(args)
    prompts = load_prompts(kit_root)
    if args.stage != "all":
        prompts = [prompt for prompt in prompts
                   if (prompt["kind"] == "addon" if args.stage == "addon" else prompt["stage"] == args.stage)]
    if args.json:
        print(json.dumps({
            "kit": str(kit_root),
            "target": str(target),
            "targetStage": detect_target_stage(target),
            "version": kit_version(kit_root),
            "prompts": [{key: prompt[key] for key in (
                "id", "title", "short", "number", "group", "stage", "kind", "when",
                "returns", "fail_signal", "placeholders",
            )} for prompt in prompts],
        }, ensure_ascii=False, indent=2))
        return 0
    stage = detect_target_stage(target)
    print(f"harness-kit 提示词库 v{kit_version(kit_root)}（kit：{kit_root}）")
    print(f"目标仓库：{target}（{'已接入' if stage == 'adopted' else '未接入'} harness-kit）")
    if target == kit_root.resolve() or kit_root.resolve() in target.parents:
        print(
            f"[WARN] 目标仓库是 kit 克隆目录；请在目标项目根目录运行，或加 --target <项目路径>。",
            file=sys.stderr,
        )
    groups: dict[str, list[dict]] = {}
    for prompt in prompts:
        groups.setdefault(prompt["group"], []).append(prompt)
    order = [group for group in GROUP_ORDER if group in groups] + [group for group in groups if group not in GROUP_ORDER]
    for group in order:
        print(f"\n{group}")
        for prompt in groups[group]:
            stage = STAGE_LABELS[prompt["stage"]]
            print(f"  {prompt['id']:<20} [{stage}]  {prompt['title']}")
    print("\n用法：")
    print("  <kit>/scripts/harness-prompt show <id>    # 打印完整提示词（自动拼前置、替换路径）")
    print("  <kit>/scripts/harness-prompt copy <id>    # 复制到剪贴板，直接粘给 Agent")
    print("  <kit>/scripts/harness-prompt render --check  # 维护者：校验文档是否最新")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    kit_root = resolve_kit(args)
    target = resolve_target(args)
    prompts = load_prompts(kit_root)
    preambles = load_preambles(kit_root)
    prompt = next((item for item in prompts if item["id"] == args.id), None)
    if prompt is None:
        known = ", ".join(item["id"] for item in prompts)
        raise PromptError(f"unknown prompt id: {args.id!r}. Known ids: {known}")
    values = parse_values(args.set, prompt)
    text, missing = compose(
        prompt, kit_root, target, preambles, values,
        include_preamble=not args.no_preamble,
    )
    for warning in target_warnings(prompt, target, kit_root) + angle_warnings(text, prompt):
        print(warning, file=sys.stderr)
    sys.stdout.write(text)
    if missing:
        print(format_missing(prompt["id"], missing), file=sys.stderr)
    return 0


def find_clipboard() -> list[str] | None:
    for candidate in CLIPBOARD_CANDIDATES:
        resolved = shutil.which(candidate[0])
        if resolved:
            return [resolved, *candidate[1:]]
    return None


def write_clipboard(command: list[str], text: str) -> bool:
    try:
        process = subprocess.run(command, input=text.encode("utf-8"), check=False)
    except OSError:
        return False
    return process.returncode == 0


def cmd_copy(args: argparse.Namespace) -> int:
    kit_root = resolve_kit(args)
    target = resolve_target(args)
    prompts = load_prompts(kit_root)
    preambles = load_preambles(kit_root)
    prompt = next((item for item in prompts if item["id"] == args.id), None)
    if prompt is None:
        known = ", ".join(item["id"] for item in prompts)
        raise PromptError(f"unknown prompt id: {args.id!r}. Known ids: {known}")
    values = parse_values(args.set, prompt)
    text, missing = compose(
        prompt, kit_root, target, preambles, values,
        include_preamble=not args.no_preamble,
    )
    warnings = target_warnings(prompt, target, kit_root) + angle_warnings(text, prompt)
    for warning in warnings:
        print(warning, file=sys.stderr)
    command = find_clipboard()
    if command and write_clipboard(command, text):
        print(f"[OK] 已复制「{prompt['title']}」到剪贴板（{len(text.splitlines())} 行；目标仓库：{target}）。")
        print("     在目标项目里打开 Agent 会话，直接粘贴即可。")
    else:
        sys.stdout.write(text)
        print(
            "[WARN] 未找到可用的剪贴板命令（pbcopy / clip / wl-copy / xclip / xsel）；"
            "以上提示词已输出到 stdout，可手动复制。",
            file=sys.stderr,
        )
    if missing:
        print(format_missing(prompt["id"], missing), file=sys.stderr)
    return 0


def cmd_render(args: argparse.Namespace) -> int:
    kit_root = resolve_kit(args)
    text = render_doc(kit_root)
    output = Path(args.output).expanduser().resolve() if args.output else kit_root / DOC_REL
    if args.check:
        try:
            current = output.read_text(encoding="utf-8")
        except OSError:
            print(f"[FAIL] {output} 不存在；运行 harness-prompt render 生成。", file=sys.stderr)
            return 1
        if current == text:
            print(f"[OK] {output} 与 prompts/ 一致（up to date）。")
            return 0
        print(
            f"[FAIL] {output} 与 prompts/ 的生成结果不一致（可能手改了文档或改了模板没重新渲染）。\n"
            "       运行：python3 <kit>/scripts/harness-prompt render",
            file=sys.stderr,
        )
        return 1
    output.parent.mkdir(parents=True, exist_ok=True)
    try:
        output.write_text(text, encoding="utf-8")
    except OSError as exc:
        raise PromptError(f"cannot write {output}: {exc}") from exc
    scenario_count = sum(1 for path in (kit_root / PROMPTS_DIRNAME).glob("*.md") if not path.name.startswith("_"))
    print(f"[OK] 已生成 {output}（{scenario_count} 个场景 + 2 份前置）。")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="harness-prompt",
        description=(
            "List / show / copy / render harness-kit prompt templates. "
            "show and copy compose the selected scenario's preamble and fill kit/target paths; "
            "stage-mismatched targets get a WARN."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  python3 harness-kit/scripts/harness-prompt list\n"
            "  cd /path/to/your-project\n"
            "  python3 harness-kit/scripts/harness-prompt copy adopt-brownfield\n"
            "  python3 harness-kit/scripts/harness-prompt show fix-bug --target . --set SYMPTOM=\"登录后闪退\"\n"
            "  python3 harness-kit/scripts/harness-prompt render --check\n"
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    list_parser = sub.add_parser("list", help="list prompt ids (grouped, with stage)")
    list_parser.add_argument("--stage", choices=("all", "unadopted", "adopted", "addon"), default="all")
    list_parser.add_argument("--json", action="store_true", help="machine-readable output")
    list_parser.add_argument("--kit", help="kit root (default: script parent parent)")
    list_parser.add_argument("--target", default=".", help="target repository (default: cwd)")
    list_parser.set_defaults(func=cmd_list)

    show_parser = sub.add_parser("show", help="print a composed prompt")
    show_parser.add_argument("id")
    show_parser.add_argument("--kit", help="kit root (default: script parent parent)")
    show_parser.add_argument("--target", default=".", help="target repository (default: cwd)")
    show_parser.add_argument("--no-preamble", action="store_true", help="do not prepend 0A/0B")
    show_parser.add_argument("--set", action="append", default=[], metavar="KEY=VALUE",
                             help="fill a placeholder (repeatable)")
    show_parser.set_defaults(func=cmd_show)

    copy_parser = sub.add_parser("copy", help="copy a composed prompt to the clipboard")
    copy_parser.add_argument("id")
    copy_parser.add_argument("--kit", help="kit root (default: script parent parent)")
    copy_parser.add_argument("--target", default=".", help="target repository (default: cwd)")
    copy_parser.add_argument("--no-preamble", action="store_true", help="do not prepend 0A/0B")
    copy_parser.add_argument("--set", action="append", default=[], metavar="KEY=VALUE",
                             help="fill a placeholder (repeatable)")
    copy_parser.set_defaults(func=cmd_copy)

    render_parser = sub.add_parser("render", help="regenerate docs/agent-prompts.md from prompts/")
    render_parser.add_argument("--kit", help="kit root (default: script parent parent)")
    render_parser.add_argument("--output", help="output path (default: <kit>/docs/agent-prompts.md)")
    render_parser.add_argument("--check", action="store_true", help="exit 1 when the doc is out of date")
    render_parser.set_defaults(func=cmd_render)
    return parser


def main(argv: list[str] | None = None) -> int:
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8")
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except PromptError as exc:
        print(f"[FAIL] {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
