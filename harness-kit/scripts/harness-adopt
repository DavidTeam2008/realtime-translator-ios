class AdoptError(Exception):
    """User-facing failure (exit 1)."""


# ── small helpers ────────────────────────────────────────────────────────
def read_text(path: Path, *, limit: int | None = None) -> str:
    try:
        data = path.read_bytes()
    except OSError:
        return ""
    if limit is not None:
        data = data[:limit]
    return data.decode("utf-8", errors="ignore")


def run_git(target: Path, args: list[str], *, timeout: int = 30) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            ["git", "-C", str(target), *args],
            capture_output=True, text=True, timeout=timeout,
        )
        return proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)


def is_probably_binary(path: Path) -> bool:
    if path.suffix.lower() in BINARY_SUFFIXES:
        return True
    try:
        with path.open("rb") as handle:
            return b"\0" in handle.read(4096)
    except OSError:
        return True


def mask_local_paths(text: str) -> str:
    return LOCAL_PATH_RE.sub("/<local>/…", text)


def sample(items: list[str], limit: int = SAMPLE_LIMIT) -> list[str]:
    return items[:limit]


# ── repository inspection ────────────────────────────────────────────────
def inspect_repo(target: Path) -> dict:
    """Return {"isRepo","branch","tracked","commits","dirtyEntries","symlinks"}.

    symlinks: list of {"path","target","absolute"} for tracked symlinks (git mode 120000).
    """
    state = {
        "isRepo": False,
        "branch": None,
        "tracked": [],
        "commits": 0,
        "dirtyEntries": [],
        "symlinks": [],
    }
    code, out, _ = run_git(target, ["rev-parse", "--is-inside-work-tree"])
    if code != 0 or out.strip() != "true":
        return state
    state["isRepo"] = True
    code, out, _ = run_git(target, ["rev-parse", "--abbrev-ref", "HEAD"])
    state["branch"] = out.strip() if code == 0 and out.strip() else None
    code, out, _ = run_git(target, ["rev-list", "--count", "HEAD"])
    try:
        state["commits"] = int(out.strip()) if code == 0 and out.strip() else 0
    except ValueError:
        state["commits"] = 0
    code, out, _ = run_git(target, ["ls-files", "-s", "-z"])
    if code == 0:
        tracked: list[str] = []
        for record in out.split("\0"):
            if not record:
                continue
            meta, _, path = record.partition("\t")
            fields = meta.split()
            if not path or len(fields) < 2:
                continue
            mode, blob = fields[0], fields[1]
            tracked.append(path)
            if mode == "120000":
                target_code, target_out, _ = run_git(target, ["cat-file", "-p", blob])
                link_target = target_out.strip() if target_code == 0 else ""
                state["symlinks"].append({
                    "path": path,
                    "target": link_target,
                    "absolute": link_target.startswith("/"),
                })
        state["tracked"] = tracked
    code, out, _ = run_git(target, ["status", "--porcelain", "-z", "--untracked-files=all"])
    if code == 0:
        entries: list[str] = []
        records = out.split("\0")
        index = 0
        while index < len(records):
            record = records[index]
            index += 1
            if len(record) < 4:
                continue
            status, path = record[:2], record[3:]
            if "R" in status or "C" in status:
                index += 1
            entries.append(f"{status.strip() or '??'} {path}")
        state["dirtyEntries"] = entries
    return state


def walk_project(target: Path) -> list[str]:
    """Fallback file list for non-git targets (bounded walk)."""
    files: list[str] = []
    for root, dirs, names in os.walk(target):
        dirs[:] = sorted(dir for dir in dirs if dir != ".git")
        for name in sorted(names):
            path = Path(root) / name
            try:
                rel = path.relative_to(target).as_posix()
            except ValueError:  # pragma: no cover - defensive
                continue
            files.append(rel)
            if len(files) >= WALK_FILE_LIMIT:
                return files
    return files


def filesystem_symlinks(target: Path) -> list[dict]:
    links: list[dict] = []
    for root, dirs, names in os.walk(target):
        dirs[:] = sorted(dir for dir in dirs if dir != ".git")
        for name in sorted(names + dirs):
            path = Path(root) / name
            if not path.is_symlink():
                continue
            try:
                link_target = os.readlink(path)
                rel = path.relative_to(target).as_posix()
            except OSError:  # pragma: no cover - defensive
                continue
            links.append({
                "path": rel,
                "target": link_target,
                "absolute": link_target.startswith("/"),
            })
    return links


# ── detection ────────────────────────────────────────────────────────────
def detect_languages(target: Path) -> tuple[list[str], list[str]]:
    languages: list[str] = []
    build_files: list[str] = []
    for language, markers in LANGUAGE_MARKERS:
        matched = False
        for marker in markers:
            if any(char in marker for char in "*?["):
                hits = sorted(path.name for path in target.glob(marker))
            else:
                hits = [marker] if (target / marker).exists() else []
            for hit in hits:
                build_files.append(hit)
                matched = True
        if matched:
            languages.append(language)
    root_python = sorted(
        path.name for path in target.glob("*.py") if path.is_file()
    )
    if root_python and "python" not in languages:
        languages.append("python")
        build_files.extend(root_python[:3])
    ordered = sorted(languages, key=lambda name: LANG_PRIORITY.index(name) if name in LANG_PRIORITY else 99)
    return ordered, sorted(set(build_files))


def primary_language(languages: list[str]) -> str:
    for language in LANG_PRIORITY:
        if language in languages:
            return language
    return languages[0] if languages else "other"


PROBE_ARGUMENTS = {"go": ["version"], "xcodebuild": ["-version"]}
PYTEST_CONFIG_FILES = ("pytest.ini", "setup.cfg", "tox.ini")
PYTEST_REQUIREMENT_FILES = (
    "requirements.txt",
    "requirements-dev.txt",
    "requirements-test.txt",
)


def python_runner(target: Path) -> list[dict]:
    """Python 解释器/启动器候选顺序：.venv → venv → uv（uv.lock）→ poetry（poetry.lock）→ python3。"""
    launchers: list[dict] = []
    for venv_name in (".venv", "venv"):
        for relative in ("bin/python", "Scripts/python.exe"):
            if (target / venv_name / relative).is_file():
                launchers.append(
                    {
                        "label": f"{venv_name}/{relative}",
                        "program": f"{venv_name}/{relative}",
                        "note": f"检测到 {venv_name}/ 虚拟环境",
                    }
                )
    if (target / "uv.lock").is_file():
        launchers.append({"label": "uv run", "program": "uv", "note": "检测到 uv.lock（需已安装 uv）"})
    if (target / "poetry.lock").is_file():
        launchers.append(
            {"label": "poetry run", "program": "poetry", "note": "检测到 poetry.lock（需已安装 poetry）"}
        )
    launchers.append({"label": "python3", "program": "python3", "note": "使用系统 python3"})
    return launchers


def pytest_evidence(target: Path) -> str | None:
    """文件级判断项目是否用 pytest（不执行任何测试）。"""
    pyproject = read_text(target / "pyproject.toml", limit=64 * 1024)
    if "pytest" in pyproject:
        return "pyproject.toml 提到 pytest"
    for name in PYTEST_CONFIG_FILES:
        if "pytest" in read_text(target / name, limit=64 * 1024):
            return f"{name} 提到 pytest"
    for name in PYTEST_REQUIREMENT_FILES:
        text = read_text(target / name, limit=64 * 1024).lower()
        if any(line.strip().startswith("pytest") or "pytest" in line for line in text.splitlines()):
            return f"{name} 含 pytest 依赖"
    return None


def detect_default_branch(target: Path) -> str | None:
    """Repository default branch (origin/HEAD -> init.defaultBranch -> current)."""
    code, out, _ = run_git(target, ["symbolic-ref", "--short", "refs/remotes/origin/HEAD"])
    if code == 0 and out.strip():
        value = out.strip()
        return value.split("/", 1)[1] if value.startswith("origin/") else value
    code, out, _ = run_git(target, ["config", "--get", "init.defaultBranch"])
    if code == 0 and out.strip():
        return out.strip()
    code, out, _ = run_git(target, ["rev-parse", "--abbrev-ref", "HEAD"])
    if code == 0 and out.strip() and out.strip() != "HEAD":
        return out.strip()
    return None


def load_token_estimator(kit_root: Path):
    """Load the kit's single-source token estimator (no duplicated heuristic)."""
    path = kit_root / "core" / "tools" / "token_estimate.py"
    if not path.is_file():
        return None
    try:
        spec = importlib.util.spec_from_file_location("harness_kit_token_estimate", path)
        if spec is None or spec.loader is None:
            return None
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except Exception:  # pragma: no cover - 防御（kit 快照损坏不应让 adopt 崩溃）
        return None
    estimate = getattr(module, "estimate_tokens", None)
    return estimate if callable(estimate) else None


def agents_assessment(target: Path, kit_root: Path) -> dict:
    """Inventory the existing root AGENTS.md against the kit template budget (K03)."""
    path = target / "AGENTS.md"
    exists = path.is_file()
    tokens = None
    if exists:
        estimator = load_token_estimator(kit_root)
        text = read_text(path, limit=MAX_MARKDOWN_BYTES)
        if estimator is not None:
            tokens = estimator(text)
    budget = DEFAULT_AGENTS_BUDGET
    over = bool(tokens is not None and tokens > budget)
    if not exists:
        mode = "replace"
    elif over:
        mode = "move"
    else:
        mode = "keep"
    return {
        "exists": exists,
        "tokens": tokens,
        "budget": budget,
        "overBudget": over,
        "overBy": (tokens - budget) if over else 0,
        "recommendedMode": mode,
        "archivePath": DEFAULT_AGENTS_ARCHIVE,
    }


def probe_candidate(target: Path, command: str) -> tuple[bool, str]:
    """可执行探测：只跑一次只读 `--version`（10s 超时），**不执行项目测试**。

    K04：这只证明「程序存在且能启动」，不证明测试命令可用；adopt 是只读盘点，
    不跑全量测试、不写目标仓库。
    """
    try:
        parts = shlex.split(command)
    except ValueError:
        return False, "命令无法解析（引号不配对）"
    if not parts:
        return False, "命令为空"
    first = parts[0]
    if "/" in first or first.startswith("."):
        if not (target / first).is_file():
            return False, f"相对路径不存在：{first}"
        if first.endswith(("python", "python3", "python.exe")):
            probe = [first, "--version"]
        else:
            return True, f"相对路径存在：{first}（不执行 --version）"
    elif "python" in Path(first).name:
        if "-m" in parts and "pytest" in parts:
            index = parts.index("-m")
            probe = parts[: index + 2] + ["--version"]
        else:
            probe = [first, "--version"]
    elif first in PROBE_ARGUMENTS:
        probe = [first, *PROBE_ARGUMENTS[first]]
    else:
        probe = [first, "--version"]
    try:
        result = subprocess.run(
            probe, cwd=str(target), capture_output=True, text=True, timeout=10
        )
    except FileNotFoundError:
        return False, f"未找到可执行程序：{probe[0]}"
    except subprocess.TimeoutExpired:
        return False, f"探测超时（10s）：{' '.join(probe)}"
    except OSError as exc:
        return False, f"探测失败：{exc}"
    probe_display = " ".join(shlex.quote(part) for part in probe)
    if result.returncode == 0:
        first_line = (result.stdout or result.stderr).strip().splitlines()
        detail = first_line[0][:80] if first_line else "exit 0"
        return True, f"仅探测 `{probe_display}` 通过：{detail}（未执行完整命令）"
    stderr = (result.stderr or result.stdout).strip().splitlines()
    detail = stderr[0][:120] if stderr else f"exit {result.returncode}"
    return False, f"仅探测 `{probe_display}` 失败（exit {result.returncode}）：{detail}"


def python_test_candidates(target: Path) -> list[dict]:
    pytest_note = pytest_evidence(target)
    runners: list[tuple[str, str]] = []
    if pytest_note:
        runners.append(("pytest", pytest_note))
    runners.append(("unittest", "未发现 pytest 或作为回退"))
    candidates: list[dict] = []
    for launcher in python_runner(target):
        for runner, runner_note in runners:
            if runner == "pytest":
                body = "-m pytest -q"
            elif (target / "tests").is_dir():
                body = "-m unittest discover -s tests -q"
            else:
                body = "-m unittest discover -q"
            candidates.append(
                {
                    "command": f"{launcher['label']} {body}",
                    "source": f"{launcher['note']}；{runner_note}",
                }
            )
    return candidates


def select_test_command(target: Path, primary: str) -> dict:
    """返回 {suggested, verified, probe, command, source}；候选探测失败会落到下一候选。"""
    if primary == "python":
        candidates = python_test_candidates(target)
        probes: list[str] = []
        verified: dict | None = None
        for candidate in candidates:
            ok, note = probe_candidate(target, candidate["command"])
            probes.append(f"{candidate['command']} → {'通过' if ok else '失败'}（{note}）")
            if ok and verified is None:
                verified = candidate
                break
        chosen = verified or candidates[0]
        if verified:
            source = f"{chosen['source']}；候选探测通过"
        else:
            source = f"{chosen['source']}；候选探测均失败（需宿主确认测试环境）"
            probes.append("回退到建议命令（未验证可执行）")
        return {
            "suggested": candidates[0]["command"],
            "verified": verified["command"] if verified else None,
            "probe": "；".join(probes),
            "command": chosen["command"],
            "source": source,
        }
    command, note = suggest_simple_command(target, primary)
    ok, probe_note = probe_candidate(target, command)
    return {
        "suggested": command,
        "verified": command if ok else None,
        "probe": f"{command} → {'通过' if ok else '失败'}（{probe_note}）",
        "command": command,
        "source": note + ("；探测通过" if ok else "；探测未通过（需宿主确认测试环境）"),
    }


def suggest_simple_command(target: Path, primary: str) -> tuple[str, str]:
    """非 Python 语言的建议命令（沿用原有启发式）。"""
    if primary == "node":
        package = target / "package.json"
        data: dict = {}
        if package.is_file():
            try:
                data = json.loads(read_text(package))
            except json.JSONDecodeError:
                data = {}
        scripts = data.get("scripts") if isinstance(data, dict) else None
        if isinstance(scripts, dict) and str(scripts.get("test") or "").strip():
            return "npm test", "from package.json scripts.test"
        dev_deps = data.get("devDependencies") if isinstance(data, dict) else None
        dev_deps = dev_deps if isinstance(dev_deps, dict) else {}
        if "tsx" in dev_deps:
            return (
                'pnpm exec tsx --test "src/**/*.test.ts"',
                "devDependencies.tsx：TS 项目优先 tsx --test；Node 24 的 node --test 不能解析"
                "无扩展名相对导入（会报 ERR_MODULE_NOT_FOUND，K04 复现条件），请按实际测试目录调整 glob",
            )
        if "vitest" in dev_deps:
            return "npx vitest run", "devDependencies.vitest"
        if (target / "tsconfig.json").is_file():
            return (
                "node --test",
                "无 scripts.test；检测到 tsconfig.json：先用 node --test 试跑，"
                "若报 ERR_MODULE_NOT_FOUND（无扩展名 TS 导入）改用 tsx --test",
            )
        return "node --test", "no scripts.test/servable package.json; using node --test (Node 18+)"
    if primary == "swift":
        if (target / "Package.swift").is_file():
            return "swift test", "from Package.swift (SwiftPM)"
        if any(target.glob("*.xcodeproj")):
            return (
                "xcodebuild test",
                "Xcode project detected: pass --test-command with -scheme/-destination; "
                "the kit cannot infer the scheme",
            )
        return "swift test", "no Package.swift; adjust for this Xcode project"
    if primary == "android":
        return (
            "./gradlew testDebugUnitTest" if (target / "gradlew").is_file() else "gradle testDebugUnitTest",
            "Gradle project detected; JDK/wrapper versions are pinned by the project",
        )
    if primary == "go":
        return "go test ./...", "go default"
    return "make test", "unknown language; edit commands.test in harness/config.json"


def suggest_test_command(target: Path, primary: str) -> tuple[str, str]:
    """兼容入口：返回 (最终建议命令, 来源说明)；候选验证结果见 select_test_command。"""
    selection = select_test_command(target, primary)
    return selection["command"], selection["source"]


def recommend_profile(
    docs_count: int, gates: dict, has_ci: bool, has_hooks: bool, has_tests: bool
) -> dict:
    """统一口径（V7）：存量仓库默认 standard；strict 只能显式选择并说明理由。"""
    score = 0
    reasons: list[str] = []
    if docs_count >= 5:
        score += 1
        reasons.append(f"docs 文档 {docs_count} 篇")
    if docs_count >= 12:
        score += 1
        reasons.append("docs 规模较大")
    if gates.get("AGENTS.md") or gates.get("HARNESS.md"):
        score += 1
        reasons.append("已有根指令/系统地图")
    if has_ci:
        score += 1
        reasons.append("已有 CI workflow")
    if has_hooks:
        score += 1
        reasons.append("已有 git hooks")
    if has_tests:
        score += 1
        reasons.append("已探测到测试入口")
    recommended = "standard"
    alternative = "strict" if score >= 4 else None
    why = (
        f"启发式得分 {score}："
        + ("、".join(reasons) if reasons else "未命中加强信号")
        + "；存量仓库默认 standard（唯一 active 计划 + 三值证据 + CI 已足够）。"
    )
    if alternative:
        why += (
            " strict 仅当确有 adapters / red-team / release-check 的真实需求时，"
            "由用户显式要求并写明理由后再选。"
        )
    else:
        why += " 当前信号不足以证明需要 strict（adapters / red-team / release-check）。"
    return {
        "recommended": recommended,
        "alternative": alternative,
        "why": why,
        "score": score,
    }


# ── findings ─────────────────────────────────────────────────────────────
def scan_broken_links(target: Path, markdown_files: list[str]) -> list[str]:
    broken: list[str] = []
    for rel in markdown_files[:MAX_MARKDOWN_FILES]:
        path = target / rel
        if path.is_symlink() or not path.is_file() or is_probably_binary(path):
            continue
        text = read_text(path, limit=MAX_MARKDOWN_BYTES)
        text = re.sub(r"```.*?```", "", text, flags=re.S)
        for line_number, line in enumerate(text.splitlines(), start=1):
            for raw in LINK_RE.findall(line):
                link = raw.strip()
                if not link or link.startswith(("http://", "https://", "mailto:", "#", "{{", "<")):
                    continue
                if link.startswith("/"):  # site-absolute URL, not a repo path
                    continue
                local = link.split("#", 1)[0]
                if not local:
                    continue
                if not (path.parent / local).exists():
                    broken.append(f"{rel}:{line_number}: {link}")
    return broken


def scan_fences(target: Path, markdown_files: list[str]) -> list[str]:
    odd: list[str] = []
    for rel in markdown_files[:MAX_MARKDOWN_FILES]:
        path = target / rel
        if path.is_symlink() or not path.is_file() or is_probably_binary(path):
            continue
        text = read_text(path, limit=MAX_MARKDOWN_BYTES)
        count = sum(1 for line in text.splitlines() if FENCE_RE.match(line))
        if count % 2 == 1:
            odd.append(f"{rel}（{count} 个 ``` 围栏）")
    return odd


def scan_stale_markers(target: Path, markdown_files: list[str]) -> list[str]:
    hits: list[str] = []
    for rel in markdown_files[:MAX_MARKDOWN_FILES]:
        path = target / rel
        if path.is_symlink() or not path.is_file() or is_probably_binary(path):
            continue
        text = read_text(path, limit=MAX_MARKDOWN_BYTES)
        for line_number, line in enumerate(text.splitlines(), start=1):
            lowered = line.lower()
            for marker in STALE_MARKERS:
                if marker.lower() in lowered:
                    hits.append(f"{rel}:{line_number}: {marker}")
            if len(hits) >= SAMPLE_LIMIT * 3:
                return hits
    return hits


def is_build_artifact(rel: str) -> bool:
    if rel in BUILD_ARTIFACT_ALLOWLIST:
        return False
    basename = rel.rsplit("/", 1)[-1]
    if basename in BUILD_ARTIFACT_ALLOWED_BASENAMES:
        return False
    if rel.lower().endswith(BUILD_ARTIFACT_ALLOWED_SUFFIXES):
        return False
    parts = rel.split("/")
    if parts and parts[0] in BUILD_DIRS:
        return True
    return rel.lower().endswith(BUILD_SUFFIXES)


def scan_local_paths(target: Path, tracked: list[str]) -> list[str]:
    hits: list[str] = []
    for rel in tracked[:MAX_TEXT_SCAN_FILES]:
        path = target / rel
        if not path.is_file() or path.is_symlink() or is_probably_binary(path):
            continue
        try:
            if path.stat().st_size > MAX_TEXT_SCAN_BYTES:
                continue
        except OSError:  # pragma: no cover - defensive
            continue
        text = read_text(path, limit=MAX_TEXT_SCAN_BYTES)
        for line_number, line in enumerate(text.splitlines(), start=1):
            if LOCAL_PATH_RE.search(line):
                hits.append(f"{rel}:{line_number}: {mask_local_paths(line.strip())[:120]}")
                if len(hits) >= SAMPLE_LIMIT * 3:
                    return hits
    return hits


def scan_large_files(target: Path, tracked: list[str]) -> list[dict]:
    large: list[dict] = []
    for rel in tracked:
        path = target / rel
        if path.is_symlink() or not path.is_file():
            continue
        try:
            size = path.stat().st_size
        except OSError:  # pragma: no cover - defensive
            continue
        if size > LARGE_FILE_BYTES:
            large.append({"path": rel, "bytes": size})
    return sorted(large, key=lambda item: item["bytes"], reverse=True)


def gitignore_expected(primary_language: str) -> list[str]:
    return list(GITIGNORE_BASE) + list(GITIGNORE_BY_LANGUAGE.get(primary_language, ()))


def missing_gitignore_entries(target: Path, primary_language: str) -> list[str]:
    expected = gitignore_expected(primary_language)
    text = read_text(target / ".gitignore", limit=256 * 1024)
    if not text.strip():
        return expected
    return [entry for entry in expected if entry not in text]


# ── inventory ────────────────────────────────────────────────────────────
def collect_inventory(
    target: Path, kit_root: Path, test_command_override: str | None = None
) -> dict:
    version = read_text(kit_root / "VERSION").strip() or "unknown"
    repo = inspect_repo(target)
    tracked = list(repo["tracked"]) or walk_project(target)
    tracked_set = set(tracked)
    default_branch = detect_default_branch(target) if repo["isRepo"] else None
    branch_drift = bool(repo["branch"] and default_branch and repo["branch"] != default_branch)

    languages, build_files = detect_languages(target)
    primary = primary_language(languages)
    selection = select_test_command(target, primary)
    if test_command_override:
        probed, probe_note = probe_candidate(target, test_command_override)
        test_command = test_command_override
        test_command_suggested = selection["suggested"]
        test_command_probe = (
            f"{test_command_override} → {'通过' if probed else '失败'}（{probe_note}）"
        )
        test_command_source = "--test-command 覆盖（同时保留建议命令）"
        test_command_executable = probed
    else:
        test_command = selection["command"]
        test_command_suggested = selection["suggested"]
        test_command_probe = selection["probe"]
        test_command_source = selection["source"]
        test_command_executable = bool(selection["verified"])

    gates_present = {name: (target / name).exists() for name in GATE_FILES}
    workflows = sorted(path.name for path in (target / ".github" / "workflows").glob("*.yml"))
    workflows += sorted(path.name for path in (target / ".github" / "workflows").glob("*.yaml"))
    has_ci = bool(workflows)
    has_hooks = (target / ".githooks" / "pre-push").is_file()
    has_tests = (target / "tests").is_dir() or any(
        name in tracked_set for name in ("pytest.ini", "tox.ini")
    ) or test_command != "make test"
    profile_info = recommend_profile(
        docs_count=len([rel for rel in tracked if rel.startswith("docs/") and rel.lower().endswith(".md")]),
        gates=gates_present,
        has_ci=has_ci,
        has_hooks=has_hooks,
        has_tests=has_tests,
    )

    markdown_files = [rel for rel in tracked if rel.lower().endswith(".md")]
    docs_files = [rel for rel in markdown_files if rel.startswith("docs/")]
    # K06：磁盘存在即算「有索引」（init 刚生成、尚未 git add 时不能误报缺失）。
    docs_index_path = target / "docs" / "README.md"
    docs_index = "docs/README.md" if docs_index_path.is_file() else None
    docs_index_tracked = "docs/README.md" in tracked_set
    index_text = read_text(docs_index_path, limit=MAX_MARKDOWN_BYTES) if docs_index else ""
    unregistered: list[str] = []
    for rel in docs_files:
        if rel == docs_index:
            continue
        stem = Path(rel).stem
        if Path(rel).name in index_text or stem in index_text:
            continue
        unregistered.append(rel)

    hygiene_symlinks = repo["symlinks"] if repo["isRepo"] else filesystem_symlinks(target)
    absolute_symlinks = [item for item in hygiene_symlinks if item["absolute"]]
    build_artifacts = sorted(rel for rel in tracked if is_build_artifact(rel))
    local_path_hits = scan_local_paths(target, tracked)
    large_files = scan_large_files(target, tracked)
    gitignore_missing = missing_gitignore_entries(target, primary)
    agents = agents_assessment(target, kit_root)

    risks: list[dict] = []

    def add_risk(risk_id: str, severity: str, detail: str) -> None:
        risks.append({"id": risk_id, "severity": severity, "detail": detail})

    worktree_dirty = len(repo["dirtyEntries"]) if repo["isRepo"] else 0
    if build_artifacts:
        add_risk("tracked-build-artifacts", "高", f"被跟踪构建产物 {len(build_artifacts)} 个（易污染仓库、放大 clone/冲突）")
    if absolute_symlinks:
        add_risk("absolute-symlinks", "高", f"绝对符号链接 {len(absolute_symlinks)} 个（换机器/CI 失效）")
    if local_path_hits:
        add_risk("local-paths", "中", f"本机绝对路径 {len(local_path_hits)} 处（公开/迁移前需脱敏）")
    if large_files:
        add_risk("large-files", "中", f">{LARGE_FILE_BYTES // (1024 * 1024)}MiB 被跟踪文件 {len(large_files)} 个")
    broken_links = scan_broken_links(target, markdown_files)
    if broken_links:
        add_risk("broken-links", "中", f"Markdown 断链 {len(broken_links)} 处")
    if docs_files and not docs_index:
        add_risk("docs-index", "中", "docs/ 存在但缺 docs/README.md 索引")
    if unregistered:
        add_risk("unregistered-docs", "低", f"未登记到 docs/README.md 的文档 {len(unregistered)} 篇")
    if not gates_present.get("AGENTS.md"):
        add_risk("no-agents", "低", "缺根 AGENTS.md（init 会生成）")
    if gitignore_missing:
        add_risk("gitignore", "中", f".gitignore 缺常见项：{', '.join(gitignore_missing)}")
    if worktree_dirty:
        add_risk("dirty-worktree", "中", f"工作树有 {worktree_dirty} 处未提交改动（改造前建议先清理）")
    if (target / "harness").is_dir():
        add_risk("existing-harness", "低", "已存在 harness/ 目录（init 会逐文件做冲突检查）")
    if agents["overBudget"]:
        add_risk(
            "agents-over-budget",
            "高",
            f"根 AGENTS.md ≈{agents['tokens']} tokens > 模板预算 {agents['budget']}（超 {agents['overBy']}）："
            f"接入时用 --agents-mode move（先 git mv 到 {agents['archivePath']} 再重写根入口）",
        )
    if branch_drift:
        add_risk(
            "branch-drift",
            "中",
            f"当前在 {repo['branch']}，仓库默认分支是 {default_branch}："
            "init 默认写当前分支会让 CI 锁死在 feature 分支，用 --default-branch 显式覆盖",
        )

    stale_markers = scan_stale_markers(target, markdown_files)
    odd_fences = scan_fences(target, markdown_files)
    root_markdown = [rel for rel in markdown_files if "/" not in rel]

    init_flags = ""
    if branch_drift and default_branch:
        init_flags += f" --default-branch {default_branch}"
    if agents["overBudget"]:
        init_flags += f" --agents-mode move --agents-archive-path {agents['archivePath']}"
    if not (target / ".githooks" / "pre-push").is_file():
        init_flags += " --install-hooks"
    next_steps = [
        "审阅本报告（默认只读：未改动目标项目）",
        "装一次入口 skill（用户级，所有仓库可见）："
        "`<kit>/scripts/harness-skill install --scope user`；"
        "之后在任意仓库对 Agent 说「接入这个项目」即可，不需要再生成提示词",
        f"运行 harness-init 接入（默认 --profile {profile_info['recommended']}；"
        f"strict 仅显式选择并写理由）："
        f"`python3 harness-kit/scripts/harness-init --profile {profile_info['recommended']}"
        f" --target <target>{init_flags}`",
        "先处理高风险项（被跟踪构建产物 / 绝对符号链接 / 本机路径）再提交",
        "用 `--write-plan` 生成改造计划草稿，补目标、验收与 scope.allow",
        "接入后运行 `make check` / `make verify-static` 复核，并 `make scorecard` / `make selftest` 建立基线",
        "测试命令只在「可执行探测」层面验证过（--version）：请在宿主实跑一次 "
        f"`{test_command}`，再用 JUnit 证据固定计数（adopt 不执行测试）",
        "接入完成后归档盘点报告："
        "`python3 harness-kit/scripts/harness-adopt --target . --archive-report <本报告路径>`",
    ]

    data: dict = {
        "target": str(target),
        "kitVersion": version,
        "generatedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "readOnly": True,
        "overview": {
            "projectName": target.name,
            "git": {
                "isRepo": repo["isRepo"],
                "branch": repo["branch"],
                "defaultBranch": default_branch,
                "branchDrift": branch_drift,
                "tracked": len(repo["tracked"]),
                "commits": repo["commits"],
                "dirty": worktree_dirty,
                "statusSample": sample(list(repo["dirtyEntries"])),
            },
            "agents": agents,
            "languages": languages,
            "primaryLanguage": primary,
            "buildFiles": build_files,
            "existingGates": {
                "present": sorted(name for name, exists in gates_present.items() if exists),
                "missing": sorted(name for name, exists in gates_present.items() if not exists),
                "workflows": workflows,
            },
        },
        "docs": {
            "count": len(docs_files),
            "hasIndex": bool(docs_index),
            "hasIndexTracked": docs_index_tracked,
            "unregistered": unregistered,
            "rootMarkdown": root_markdown,
            "brokenLinks": broken_links,
            "oddFences": odd_fences,
            "staleMarkers": stale_markers,
            "markdownTotal": len(markdown_files),
        },
        "hygiene": {
            "trackedBuildArtifacts": build_artifacts,
            "absoluteSymlinks": absolute_symlinks,
            "symlinks": hygiene_symlinks,
            "localPathHits": local_path_hits,
            "largeTrackedFiles": large_files,
            "gitignoreMissing": gitignore_missing,
        },
        "recommendation": {
            "recommended": profile_info["recommended"],
            "alternative": profile_info["alternative"],
            "why": profile_info["why"],
            "score": profile_info["score"],
            "testCommand": test_command,
            "testCommandSuggested": test_command_suggested,
            "testCommandSource": test_command_source,
            "testCommandExecutable": test_command_executable,
            "testCommandProbe": test_command_probe,
            # K04：探测只证明程序可执行；adopt 不跑项目测试，没有「已验证命令」这层保证。
            "testCommandProbeOnly": True,
            "testCommandSmoke": "not-run",
            "risks": risks,
        },
        "nextSteps": next_steps,
        "writePlan": {"written": False, "path": None},
    }
    return data


# ── Markdown report ──────────────────────────────────────────────────────
def _bullet(items: list[str], *, empty: str = "（无）", limit: int = SAMPLE_LIMIT) -> list[str]:
    if not items:
        return [f"- {empty}"]
    return [f"- {item}" for item in sample(items, limit)]


def render_markdown(data: dict) -> str:
    overview = data["overview"]
    git_info = overview["git"]
    docs = data["docs"]
    hygiene = data["hygiene"]
    recommendation = data["recommendation"]
    lines: list[str] = [
        f"# {overview['projectName']} · harness-kit 存量盘点",
        "",
        f"> 生成时间：{data['generatedAt']} ｜ kit 版本：{data['kitVersion']} ｜ 模式：只读"
        "（未修改目标项目；报告不记录绝对路径）",
        "",
        "## 概览",
        "",
        "| 项 | 值 |",
        "| --- | --- |",
        f"| git 仓库 | {'是' if git_info['isRepo'] else '否'} |",
        f"| 当前分支 | {git_info['branch'] or '（非 git 或无提交）'} |",
        f"| 默认分支 | {git_info['defaultBranch'] or '（未探测到）'}"
        + ("（当前分支与默认分支不一致）" if git_info['branchDrift'] else "") + " |",
        f"| 跟踪文件 | {git_info['tracked']} |",
        f"| 提交数 | {git_info['commits']} |",
        f"| 未提交改动 | {git_info['dirty']} |",
        f"| 语言 | {', '.join(overview['languages']) or '未探测到'} |",
        f"| 构建文件 | {', '.join(overview['buildFiles']) or '未探测到'} |",
        "",
        "既有门禁文件：",
        "",
        f"- 已存在：{', '.join(overview['existingGates']['present']) or '（无）'}",
        f"- 缺少：{', '.join(overview['existingGates']['missing']) or '（无）'}",
        "",
        "## 文档盘点",
        "",
        f"- docs 数量：{docs['count']} 篇（Markdown 合计 {docs['markdownTotal']} 篇）",
        f"- docs/README 索引：{'有' if docs['hasIndex'] else '缺失'}",
        f"- 未登记文档（{len(docs['unregistered'])}）：",
        *_indent(_bullet(docs["unregistered"], empty="（无）")),
        f"- 根 markdown（{len(docs['rootMarkdown'])}）：",
        *_indent(_bullet(docs["rootMarkdown"], empty="（无）")),
        f"- 断链样本（{len(docs['brokenLinks'])}）：",
        *_indent(_bullet(docs["brokenLinks"], empty="（无）")),
        f"- 围栏奇数文件（{len(docs['oddFences'])}）：",
        *_indent(_bullet(docs["oddFences"], empty="（无）")),
        f"- 疑似过期标记（{len(docs['staleMarkers'])}）：",
        *_indent(_bullet(docs["staleMarkers"], empty="（无）")),
        "",
        "## 卫生盘点",
        "",
        f"- 被跟踪构建产物（{len(hygiene['trackedBuildArtifacts'])}）：",
        *_indent(_bullet(hygiene["trackedBuildArtifacts"], empty="（无）")),
        f"- 绝对符号链接（{len(hygiene['absoluteSymlinks'])}）：",
        *_indent(_bullet(
            [f"{item['path']} → {item['target']}" for item in hygiene["absoluteSymlinks"]],
            empty="（无）",
        )),
        f"- 本机路径样本（{len(hygiene['localPathHits'])}）：",
        *_indent(_bullet(hygiene["localPathHits"], empty="（无）")),
        f"- >{LARGE_FILE_BYTES // (1024 * 1024)}MiB 被跟踪文件（{len(hygiene['largeTrackedFiles'])}）：",
        *_indent(_bullet(
            [f"{item['path']}（{item['bytes']} bytes）" for item in hygiene["largeTrackedFiles"]],
            empty="（无）",
        )),
        f"- .gitignore 缺失常见项（{len(hygiene['gitignoreMissing'])}）："
        f"{', '.join(hygiene['gitignoreMissing']) or '（无）'}",
        "",
        "## 建议",
        "",
        f"- 推荐 profile：**{recommendation['recommended']}**（存量仓库默认；接入时用 `--profile` 覆盖）",
        f"- 备选 profile："
        + (
            f"**{recommendation['alternative']}**（仅显式选择并说明理由）"
            if recommendation["alternative"]
            else "无（未发现需要 strict 的信号）"
        ),
        f"- 判断理由：{recommendation['why']}",
        f"- 建议：`{recommendation['testCommandSuggested']}`",
        f"- 可执行探测（只跑 `--version` / `--help`，不执行项目测试）："
        f"{recommendation['testCommandProbe'] or '（非 Python 语言，未做候选探测）'}",
        "- 测试可用性：**未验证（smoke=not-run）**；adopt 是只读盘点，不跑宿主测试。"
        f"请先在宿主实跑 `{recommendation['testCommand']}`，接入后以 JUnit 证据固定计数。",
        f"- 使用命令：`{recommendation['testCommand']}`（{recommendation['testCommandSource']}）",
        f"- 风险清单（{len(recommendation['risks'])}）：",
        *_indent([f"- [{item['severity']}] {item['detail']}" for item in recommendation["risks"]] or ["- （无）"]),
        "",
        "## AGENTS 迁移建议",
        "",
        f"- 现有根 AGENTS.md：{'有' if overview['agents']['exists'] else '无'}"
        + (
            f"（≈{overview['agents']['tokens']} tokens；模板预算 {overview['agents']['budget']}"
            f"，{'超预算 ' + str(overview['agents']['overBy']) + ' tokens' if overview['agents']['overBudget'] else '在预算内'}）"
            if overview["agents"]["exists"]
            else ""
        ),
        f"- 推荐模式：`--agents-mode {overview['agents']['recommendedMode']}`",
        "  - `replace`：目标没有 AGENTS.md 时直接生成模板；",
        "  - `keep`：保留现有 AGENTS.md（预算门禁可能红，适合先接入、后迁移）；",
        "  - `move`：`git mv AGENTS.md "
        f"{overview['agents']['archivePath']}` 保留历史，再生成模板并自动登记 docs 索引/白名单。",
        f"- 迁移命令示例：`harness-init ... --agents-mode "
        f"{overview['agents']['recommendedMode']}"
        + (f" --agents-archive-path {overview['agents']['archivePath']}" if overview["agents"]["recommendedMode"] == "move" else "")
        + "`",
        "",
        "## 下一步",
        "",
        *[f"- [ ] {step}" for step in data["nextSteps"]],
        "",
    ]
    return "\n".join(lines)


def _indent(items: list[str]) -> list[str]:
    return [f"  {item}" for item in items]


# ── --write-plan ─────────────────────────────────────────────────────────
def _findings_markdown(data: dict, *, redact: bool = True) -> str:
    docs = data["docs"]
    hygiene = data["hygiene"]
    recommendation = data["recommendation"]
    git_info = data["overview"]["git"]
    lines = [
        f"- git：{'仓库' if git_info['isRepo'] else '非仓库'}，"
        f"{git_info['tracked']} 个跟踪文件，{git_info['dirty']} 处未提交",
        f"- docs：{docs['count']} 篇，索引{'有' if docs['hasIndex'] else '缺失'}，未登记 {len(docs['unregistered'])} 篇",
        f"- 断链 {len(docs['brokenLinks'])} 处；围栏奇数 {len(docs['oddFences'])} 个；疑似过期标记 {len(docs['staleMarkers'])} 处",
        f"- 被跟踪构建产物 {len(hygiene['trackedBuildArtifacts'])} 个；绝对符号链接 {len(hygiene['absoluteSymlinks'])} 个",
        f"- 本机路径样本 {len(hygiene['localPathHits'])} 处；"
        f">{LARGE_FILE_BYTES // (1024 * 1024)}MiB 文件 {len(hygiene['largeTrackedFiles'])} 个",
        f"- .gitignore 缺失项：{', '.join(hygiene['gitignoreMissing']) or '（无）'}",
        f"- 根 AGENTS.md：{'有' if data['overview']['agents']['exists'] else '无'}"
        + (
            f"，≈{data['overview']['agents']['tokens']} tokens（预算 {data['overview']['agents']['budget']}）"
            if data["overview"]["agents"]["tokens"] is not None
            else ""
        ),
        f"- 默认分支：{git_info['defaultBranch'] or '未知'}"
        + ("（当前分支不一致）" if git_info["branchDrift"] else ""),
    ]
    text = "\n".join(lines)
    return mask_local_paths(text) if redact else text


def _risks_markdown(data: dict, *, redact: bool = True) -> str:
    risks = data["recommendation"]["risks"]
    if not risks:
        return "- （无）"
    lines = [f"- [{item['severity']}] {item['detail']}" for item in risks]
    text = "\n".join(lines)
    return mask_local_paths(text) if redact else text


def _next_steps_markdown(data: dict) -> str:
    return "\n".join(f"- [ ] {step}" for step in data["nextSteps"])


def placeholder_values(data: dict, report_ref: str) -> dict[str, str]:
    docs = data["docs"]
    hygiene = data["hygiene"]
    recommendation = data["recommendation"]
    overview = data["overview"]
    git_info = overview["git"]
    date = data["generatedAt"][:10]
    summary = (
        f"跟踪文件 {git_info['tracked']}；提交 {git_info['commits']}；"
        f"文档 {docs['count']} 篇；未登记 {len(docs['unregistered'])}；"
        f"断链 {len(docs['brokenLinks'])}；构建产物 {len(hygiene['trackedBuildArtifacts'])}；"
        f"本机路径 {len(hygiene['localPathHits'])}"
    )
    findings = _findings_markdown(data)
    risks = _risks_markdown(data)
    next_steps = _next_steps_markdown(data)
    values = {
        "PROJECT_NAME": overview["projectName"],
        "PROJECT": overview["projectName"],
        "PROJECT_LANGUAGE": overview["primaryLanguage"],
        "PRIMARY_LANGUAGE": overview["primaryLanguage"],
        "LANGUAGES": ", ".join(overview["languages"]) or "unknown",
        "TEST_COMMAND": recommendation["testCommand"],
        "TEST_COMMAND_PROBE": recommendation["testCommandProbe"] or "（未探测）",
        "TEST_COMMAND_SMOKE": recommendation["testCommandSmoke"],
        "TEST_COMMAND_SOURCE": recommendation["testCommandSource"],
        "TEST_COMMAND_EXECUTABLE": "true" if recommendation["testCommandExecutable"] else "false",
        "AGENTS_MODE": overview["agents"]["recommendedMode"],
        "AGENTS_TOKENS": str(overview["agents"]["tokens"]) if overview["agents"]["tokens"] is not None else "unknown",
        "AGENTS_BUDGET": str(overview["agents"]["budget"]),
        "GIT_DEFAULT_BRANCH": str(git_info["defaultBranch"] or "n/a"),
        "PROFILE": recommendation["recommended"],
        "PROFILE_ALTERNATIVE": recommendation["alternative"] or "none",
        "PROFILE_WHY": recommendation["why"],
        "KIT_VERSION": data["kitVersion"],
        "DATE": date,
        "YEAR": date[:4],
        "TARGET": overview["projectName"],
        "TARGET_NAME": overview["projectName"],
        "TARGET_PATH": ".",
        "REPORT_PATH": report_ref,
        "REPORT": report_ref,
        "SUMMARY": summary,
        "FINDINGS": findings,
        "RISKS": risks,
        "NEXT_STEPS": next_steps,
        "STATUS": "active",
        "OWNER": "unassigned",
        "TOPIC": "adopt-harness",
        "LEVEL": "L2",
        "DOCS_COUNT": str(docs["count"]),
        "TRACKED_FILES": str(git_info["tracked"]),
        "GIT_BRANCH": str(git_info["branch"] or "n/a"),
        "DIRTY_COUNT": str(git_info["dirty"]),
        "COMMITS": str(git_info["commits"]),
        "BROKEN_LINKS": str(len(docs["brokenLinks"])),
        "UNREGISTERED_DOCS": str(len(docs["unregistered"])),
        "ROOT_MARKDOWN": str(len(docs["rootMarkdown"])),
        "BUILD_ARTIFACTS": str(len(hygiene["trackedBuildArtifacts"])),
        "ABSOLUTE_SYMLINKS": str(len(hygiene["absoluteSymlinks"])),
        "LOCAL_PATH_HITS": str(len(hygiene["localPathHits"])),
        "LARGE_FILES": str(len(hygiene["largeTrackedFiles"])),
        "GITIGNORE_MISSING": ", ".join(hygiene["gitignoreMissing"]) or "none",
        # Adoption-specific aliases (templates may use either naming style)
        "ADOPTION_DATE": date,
        "ADOPTION_PROFILE": recommendation["recommended"],
        "ADOPTION_SUMMARY": summary,
        "ADOPTION_FINDINGS": findings,
        "ADOPTION_RISKS": risks,
        "ADOPTION_NEXT_STEPS": next_steps,
    }
    return values


def render_adoption_plan(target: Path, kit_root: Path, data: dict, *, report_ref: str) -> dict:
    plans_dir = target / "harness" / "plans"
    if not plans_dir.is_dir():
        raise AdoptError(
            f"--write-plan requires an existing directory: {plans_dir} "
            "(run harness-init first, or create it manually)"
        )
    template = kit_root / "core" / "templates" / "harness" / "plans" / "_adoption.md.template"
    if not template.is_file():
        raise AdoptError(
            f"adoption plan template not found: {template} "
            "(the kit is incomplete; update harness-kit and retry)"
        )
    text = template.read_text(encoding="utf-8")
    values = placeholder_values(data, report_ref)
    unknown = sorted({match.group(1) for match in PLACEHOLDER_RE.finditer(text) if match.group(1) not in values})
    if unknown:
        raise AdoptError(
            "adoption template uses unsupported placeholders: "
            + ", ".join("{{" + name + "}}" for name in unknown)
            + " (update harness-adopt or the template so they stay in sync)"
        )
    rendered = PLACEHOLDER_RE.sub(lambda match: values[match.group(1)], text)
    for token, key in ANGLE_SUBS:
        rendered = rendered.replace(token, values.get(key, ""))
    rendered = mask_local_paths(rendered)
    if "{{" in rendered:
        raise AdoptError("rendered adoption plan still contains unresolved {{...}} placeholders")
    date = data["generatedAt"][:10]
    output = plans_dir / f"{date}-adopt-harness.md"
    if output.exists():
        raise AdoptError(f"refusing to overwrite existing plan: {output}")
    try:
        output.write_text(rendered, encoding="utf-8")
    except OSError as exc:
        raise AdoptError(f"cannot write adoption plan: {exc}") from exc
    return {"written": True, "path": str(output)}


LOCAL_SEGMENT_RE = re.compile(r"/(?:Users|home|Volumes)/[^\s'\"`<>()\[\]{}|]+")


def sanitize_report_text(text: str, target: Path) -> str:
    """归档前脱敏：目标仓根相对化、用户主目录 → $HOME、常见本机路径段 → 占位。"""
    try:
        root = str(target.resolve())
    except OSError:  # pragma: no cover - 防御
        root = str(target)
    if root and root != "/":
        text = text.replace(root + "/", "").replace(root, ".")
    home = str(Path.home())
    if home and home != "/":
        text = text.replace(home, "$HOME")
    return LOCAL_SEGMENT_RE.sub("<local-path>", text)


def archive_report(target: Path, source: Path) -> dict:
    """把既有盘点报告脱敏后复制到 <target>/harness/reports/adoption-<UTC-YYYY-MM-DD>.md。

    只归档、不重新扫描；拒绝覆盖已有归档报告；复制前做文本脱敏。
    """
    source = source.expanduser()
    if not source.is_file():
        raise AdoptError(f"--archive-report 文件不存在：{source}")
    date = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    reports_dir = target / "harness" / "reports"
    destination = reports_dir / f"adoption-{date}.md"
    if destination.exists():
        raise AdoptError(f"拒绝覆盖已有归档报告：{destination}")
    try:
        original = source.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        raise AdoptError(f"无法读取待归档报告：{exc}") from exc
    header = (
        "> sanitized：本报告归档时已脱敏（目标仓根相对化、用户主目录 → `$HOME`、"
        "本机路径段 → `<local-path>`）；只复制既有报告，未重新扫描。\n"
        f"> 来源命令：`harness-adopt --archive-report {source.name}`"
        f"（UTC {date} 归档）\n\n"
    )
    try:
        reports_dir.mkdir(parents=True, exist_ok=True)
        destination.write_text(header + sanitize_report_text(original, target), encoding="utf-8")
    except OSError as exc:
        raise AdoptError(f"无法归档报告：{exc}") from exc
    return {
        "archived": True,
        "sanitized": True,
        "path": destination.relative_to(target).as_posix(),
        "sourceName": source.name,
        "archivedAt": f"{date}",
    }


# ── CLI ──────────────────────────────────────────────────────────────────
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="harness-adopt",
        description=(
            "Read-only inventory of an existing project before adopting harness-kit "
            "(Markdown report + optional JSON + optional adoption plan draft)."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  python3 harness-kit/scripts/harness-adopt --target ../myapp\n"
            "  python3 harness-kit/scripts/harness-adopt --target ../myapp --report adopt-report.md\n"
            "  python3 harness-kit/scripts/harness-adopt --target ../myapp --json\n"
            "  python3 harness-kit/scripts/harness-adopt --target ../myapp --write-plan\n"
            "  python3 harness-kit/scripts/harness-adopt --target ../myapp "
            "--test-command '.venv/bin/python -m pytest -q'\n"
            "  python3 harness-kit/scripts/harness-adopt --target . "
            "--archive-report /tmp/adoption-report.md\n"
        ),
    )
    parser.add_argument("--target", required=True, help="existing project directory to inventory (required)")
    parser.add_argument("--report", help="write the Markdown report to this path (only that file is written)")
    parser.add_argument("--json", action="store_true", help="print machine-readable JSON to stdout")
    parser.add_argument(
        "--write-plan",
        action="store_true",
        help="render the adoption plan template into <target>/harness/plans/ (requires that directory)",
    )
    parser.add_argument(
        "--test-command",
        help="override the detected test command (report marks source and executable probe)",
    )
    parser.add_argument(
        "--archive-report",
        metavar="PATH",
        help="copy an existing inventory report into <target>/harness/reports/ "
        "(no rescan; refuses to overwrite)",
    )
    parser.add_argument("--root", default=str(DEFAULT_KIT_ROOT), help="kit root (default: script parent parent)")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    kit_root = Path(args.root).expanduser().resolve()
    target = Path(args.target).expanduser().resolve()
    try:
        if not target.is_dir():
            raise AdoptError(f"target directory does not exist: {target}")
        if not kit_root.is_dir():
            raise AdoptError(f"kit root does not exist: {kit_root}")
        if args.archive_report:
            archived = archive_report(target, Path(args.archive_report))
            if args.json:
                print(json.dumps(archived, ensure_ascii=False, indent=2))
            else:
                print(f"[OK] adoption report archived: {archived['path']}")
            return 0
        data = collect_inventory(target, kit_root, test_command_override=args.test_command)
        report_ref = "（未生成；可用 --report 生成）"
        if args.report:
            report_path = Path(args.report).expanduser()
            try:
                report_path.resolve().relative_to(target)
                report_ref = report_path.resolve().relative_to(target).as_posix()
            except ValueError:
                report_ref = report_path.name
        if args.write_plan:
            data["writePlan"] = render_adoption_plan(target, kit_root, data, report_ref=report_ref)
        markdown = render_markdown(data)
        if args.report:
            try:
                Path(args.report).expanduser().write_text(markdown, encoding="utf-8")
            except OSError as exc:
                raise AdoptError(f"cannot write report: {exc}") from exc
        if args.json:
            print(json.dumps(data, ensure_ascii=False, indent=2))
        elif args.report:
            print(f"[OK] report written: {args.report}")
        else:
            print(markdown)
        if data["writePlan"]["written"] and not args.json:
            print(f"[OK] adoption plan written: {data['writePlan']['path']}")
        return 0
    except AdoptError as exc:
        print(f"[FAIL] {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
