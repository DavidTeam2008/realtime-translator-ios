    ("android", ("build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", "gradlew", "gradle.properties")),
    ("node", ("package.json",)),
    ("python", ("pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "tox.ini")),
    ("go", ("go.mod",)),
)
LANG_PRIORITY = ("swift", "android", "node", "python", "go")
ANGLE_SUBS = (
    ("<date>", "DATE"), ("<DATE>", "DATE"), ("<YYYY-MM-DD>", "DATE"),
    ("<status>", "STATUS"), ("<STATUS>", "STATUS"),
    ("<owner>", "OWNER"), ("<topic>", "TOPIC"),
