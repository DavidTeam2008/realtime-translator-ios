{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness config (target project)",
  "type": "object",
  "required": [
    "kitVersion",
    "project",
    "paths",
    "commands",
    "claims"
  ],
  "additionalProperties": true,
  "properties": {
    "kitVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "docs",
        "references",
        "harness",
        "plans",
        "evidence",
        "tools"
      ],
      "properties": {
        "docs": {
          "type": "string"
        },
        "references": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "plans": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "reviews": {
          "type": "string"
        },
        "tools": {
          "type": "string"
        },
        "rootDocs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "instructions": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "nested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nestedMaxBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "budgets": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sensitivePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nestedMaxTokens": {
          "type": "integer",
          "minimum": 256
        }
      }
    },
    "docs": {
      "type": "object",
      "properties": {
        "publicWhitelist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicBudget": {
          "type": "integer",
          "minimum": 1
        },
        "rootMarkdownAllowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "required": [
        "test"
      ],
      "properties": {
        "check": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        },
        "test": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "test-count",
              "static"
            ]
          },
          "baseline": {
            "type": "string"
          },
          "floor": {
            "type": "string"
          },
          "expectedSkipped": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "command": {
            "type": "string"
          },
          "requireArtifact": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "environment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "os": {
                "type": "string"
              },
              "python": {
                "type": "string"
              }
            }
          },
          "floorByEnvironment": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "adapters": {
      "type": "object"
    },
    "hygiene": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trackedArtifactGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rootAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "localPathPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipLocalPathScan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxTrackedFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "forbidAbsoluteSymlinks": {
          "type": "boolean"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sourceRoot": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "symbolGuards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1
        },
        "maxCommits": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "harden": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSkippedRange": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDays": {
          "type": "integer",
          "minimum": 1
        },
        "exceptionMaxDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
