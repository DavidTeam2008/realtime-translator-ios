{
  "kitVersion": "0.5.5",
  "project": {
    "name": "Duiyi",
    "language": "swift"
  },
  "paths": {
    "docs": "docs",
    "references": "references",
    "harness": "harness",
    "plans": "harness/plans",
    "evidence": "harness/evidence",
    "reviews": "harness/reviews",
    "tools": "tools",
    "rootDocs": [
      "README.md",
      "AGENTS.md",
      "HARNESS.md",
      "CONTRIBUTING.md"
    ]
  },
  "instructions": {
    "root": "AGENTS.md",
    "nested": [
      "docs/AGENTS.md",
      "harness/AGENTS.md",
      "Duiyi/Services/AGENTS.md",
      "Duiyi/Features/AGENTS.md",
      "DuiyiTests/AGENTS.md",
      "DuiyiUITests/AGENTS.md"
    ],
    "nestedMaxBytes": 8192,
    "nestedMaxTokens": 2000,
    "budgets": {
      "AGENTS.md": 1650,
      "references/contracts.md": 975,
      "references/verification.md": 975,
      "references/workflow.md": 975,
      "docs/README.md": 1000,
      "HARNESS.md": 1500
    },
    "sensitivePatterns": [
      "/Users/",
      "sk-"
    ]
  },
  "docs": {
    "publicWhitelist": [
      "README.md",
      "AGENTS.md",
      "docs/README.md",
      "docs/AGENTS.md",
      "docs/01-product-design.md",
      "docs/02-architecture.md",
      "docs/03-tech-choices.md",
      "docs/04-roadmap.md",
      "docs/decisions.md",
      "docs/case-startup-performance.md",
      "docs/case-native-openspec-delivery.md",
      "docs/harness-scorecard.md"
    ],
    "publicBudget": 10,
    "rootMarkdownAllowed": [
      "README.md",
      "AGENTS.md",
      "HARNESS.md",
      "CONTRIBUTING.md",
      "AGENTS.local.md",
      "CLAUDE.local.md"
    ]
  },
  "commands": {
    "check": "make check",
    "verify": "make verify-static",
    "test": "make test"
  },
  "claims": [
    {
      "name": "unit-tests-pass",
      "type": "test-count",
      "baseline": "harness/test-baseline.json",
      "floor": "unit.floor",
      "expectedSkipped": "expectedSkipped.unit",
      "requireArtifact": true,
      "requireManifest": true,
      "expectedTarget": {
        "project": "Duiyi.xcodeproj",
        "scheme": "Duiyi",
        "destination": "platform=iOS Simulator,name=iPhone 17 Pro Max,OS=26.4.1",
        "derivedDataPath": "/tmp/duiyi-build",
        "onlyTesting": "DuiyiTests"
      },
      "resultBundleRoot": "/tmp/duiyi-evidence",
      "command": "make test"
    },
    {
      "name": "ui-tests-pass",
      "type": "test-count",
      "baseline": "harness/test-baseline.json",
      "floor": "ui.passedFloor",
      "expectedSkipped": "expectedSkipped.ui",
      "required": false,
      "requireArtifact": true,
      "requireManifest": true,
      "expectedTarget": {
        "project": "Duiyi.xcodeproj",
        "scheme": "Duiyi",
        "destination": "platform=iOS Simulator,name=iPhone 17 Pro Max,OS=26.4.1",
        "derivedDataPath": "/tmp/duiyi-build",
        "onlyTesting": "DuiyiUITests"
      },
      "resultBundleRoot": "/tmp/duiyi-evidence",
      "command": "make test-ui"
    },
    {
      "name": "ui-device-tests-pass",
      "type": "test-count",
      "baseline": "harness/test-baseline.json",
      "floor": "ui.passedFloor",
      "expectedSkipped": 0,
      "required": false,
      "requireArtifact": true,
      "requireManifest": true,
      "requiresSigning": true,
      "sanitizeDeviceName": true,
      "warmupOnlyTesting": "DuiyiTests/TaskStoreTests",
      "environment": {
        "id": "physical-device"
      },
      "expectedTarget": {
        "project": "Duiyi.xcodeproj",
        "scheme": "Duiyi",
        "destination": "platform=iOS,arch=arm64",
        "derivedDataPath": "/tmp/duiyi-build-device",
        "onlyTesting": "DuiyiUITests"
      },
      "resultBundleRoot": "/tmp/duiyi-evidence-device",
      "command": "APM_TEAM=<local-team> make evidence-ui-device"
    },
    {
      "name": "device-tests-pass",
      "type": "test-count",
      "baseline": "harness/test-baseline.json",
      "floor": "device.floor",
      "expectedSkipped": "expectedSkipped.device",
      "required": false,
      "requireArtifact": true,
      "command": "harness/tools/device-test.sh"
    },
    {
      "name": "docs-pass",
      "type": "static",
      "command": "python3 tools/check_docs.py"
    }
  ],
  "freshness": {
    "unit-tests-pass": [
      "**/*.swift",
      "DuiyiTests/**",
      "Duiyi.xcodeproj/**",
      "Makefile",
      "tools/**",
      "harness/config.json",
      "harness/test-baseline.json"
    ],
    "ui-tests-pass": [
      "**/*.swift",
      "DuiyiUITests/**",
      "Duiyi.xcodeproj/**",
      "Makefile",
      "tools/**",
      "harness/config.json",
      "harness/test-baseline.json"
    ],
    "ui-device-tests-pass": [
      "**/*.swift",
      "DuiyiUITests/**",
      "Duiyi.xcodeproj/**",
      "Makefile",
      "tools/**",
      "harness/config.json",
      "harness/test-baseline.json"
    ],
    "device-tests-pass": [
      "**/*.swift",
      "Duiyi.xcodeproj/**",
      "Makefile",
      "tools/**",
      "harness/config.json",
      "harness/test-baseline.json"
    ],
    "docs-pass": [
      "docs/**",
      "references/**",
      "AGENTS.md",
      "HARNESS.md"
    ]
  },
  "scorecard": {
    "maxAgeDays": 30,
    "maxCommits": 50
  },
  "adapters": {
    "claudeCode": {
      "skillsSource": ".dsh/skills",
      "skillsTarget": ".claude/skills"
    }
  },
  "delivery": {
    "ci": {
      "required": false,
      "reason": "P0 2026-11-18 waiver: self-hosted macOS unit/UI not enabled",
      "expires": "2026-12-31"
    },
    "requiredJobs": [
      "static gates (ubuntu)"
    ],
    "discipline": {
      "required": true,
      "dir": "harness/evidence/discipline"
    },
    "provenance": {
      "required": true,
      "dir": "harness/receipts/openspec"
    },
    "contractLint": {
      "required": true,
      "profile": "strict"
    },
    "skills": {
      "required": false,
      "manifest": "tools/vendor/ai_delivery_toolchain/skills.manifest.json",
      "dir": "harness/receipts/skills"
    }
  }
}
